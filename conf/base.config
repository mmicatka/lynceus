// Base process configuration — resource labels used across modules.

process {
  cpus = { 1 * task.attempt }
  memory = { 2.GB * task.attempt }
  time = { 1.h * task.attempt }

  errorStrategy = { (task.exitStatus in 130..145 || task.exitStatus == 104) ? 'retry' : 'finish' }
  maxRetries = 2
  maxErrors = -1

  withLabel: process_single {
    cpus = { 1 * task.attempt }
    memory = { 2.GB * task.attempt }
    time = { 2.h * task.attempt }
  }

  withLabel: process_medium {
    cpus = { 4 * task.attempt }
    memory = { 8.GB * task.attempt }
    time = { 4.h * task.attempt }
  }
}
