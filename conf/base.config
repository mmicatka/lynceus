// Base process configuration — resource labels used across modules.

process {
  errorStrategy = { (task.exitStatus in 130..145 || task.exitStatus == 104) ? 'retry' : 'finish' }
  maxRetries = 2
  maxErrors = -1

  withLabel: gpu {
    maxForks = 1
  }

  // nextflow calls everything s3 "aws"
  pod = [[env: 'AWS_ACCESS_KEY_ID', secret: 'garage-s3-creds/AWS_ACCESS_KEY_ID'], [env: 'AWS_SECRET_ACCESS_KEY', secret: 'garage-s3-creds/AWS_SECRET_ACCESS_KEY']]
}

aws {
  region = 'us-east-1'
  client {
    endpoint = 'http://192.168.1.4:3900'
    s3PathStyleAccess = true
  }
}

workDir = 's3://lynceus-work/work'

profiles {
  'k3s-onprem' {
    process.executor = 'k8s'
    process.scratch = true
    wave {
      enabled = true
    }
    fusion {
      enabled = true
    }

    k8s {
      namespace = 'lynceus'
      context = 'default'
    }
  }
}
