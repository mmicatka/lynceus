// Lynceus pipeline configuration
//
// Params are YAML-driven: defaults live in conf/params.yaml and are
// loaded via -params-file (baked into the default run command below),
// so `params {}` blocks here only hold structural fallbacks.

manifest {
  name = 'lynceus'
  description = 'Modular platform for conformational-state-aware ligand discovery'
  author = 'Lynceus contributors'
  mainScript = 'main.nf'
  nextflowVersion = '!>=26.04.4'
  version = '0.1.0'
}

// Structural fallback only — real defaults come from conf/params.yaml.
params {
  uri_list = "${projectDir}/assets/candidate_uris.txt"
  outdir = 'results'
}

includeConfig 'conf/base.config'

docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

profiles {
  singularity {
    docker.enabled = false
    singularity.enabled = true
    singularity.autoMounts = true
  }
}

dag {
  enabled = true
  file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

report {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

trace {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_trace.txt"
}
