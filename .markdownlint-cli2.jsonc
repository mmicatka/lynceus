{
    "ignores": [
        "**/.git"
    ],
    "config": {
        "default": true,
        "MD001": true,
        "MD004": {
            "style": "dash"
        },
        "MD007": {
            "indent": 2
        },
        "MD013": false,
        "MD024": {
            "siblings_only": true
        },
        "MD026": {
            "punctuation": ".,;:!"
        },
        "MD029": {
            "style": "one"
        },
        "MD033": false,
        "MD036": false,
        "MD041": false
    }
}
